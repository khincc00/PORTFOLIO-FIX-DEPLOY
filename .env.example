# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (RAHASIA, hanya dipakai di server untuk admin berita)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Nomor WhatsApp untuk tombol "Pesan" di /toko (format internasional tanpa +, contoh 6281234567890).
# Kosongkan kalau belum siap; tombol pesan akan memakai email.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Akun Admin Dashboard (/admin)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-password
# String acak panjang untuk menandatangani cookie sesi admin
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Runtime GitHub content archive. NEVER use NEXT_PUBLIC_ for these secrets.
# Fine-grained token: only this repository, Contents read/write.
CONTENT_GITHUB_TOKEN=
CONTENT_GITHUB_REPOSITORY=khincc00/PORTFOLIO-FIX-DEPLOY
# Pre-create this branch from main. Keep it separate to avoid deploy-on-every-edit.
CONTENT_GITHUB_BRANCH=content-sync
# Same value as GitHub Actions repository secret CONTENT_SYNC_CRON_SECRET.
CONTENT_SYNC_CRON_SECRET=
